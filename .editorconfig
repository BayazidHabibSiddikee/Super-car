# EditorConfig for Supercar RC Car project
# Helps maintain consistent coding styles across editors and IDEs

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.ino]
indent_size = 2
insert_final_newline = true

[*.py]
indent_size = 4
max_line_length = 100

[*.html]
indent_size = 2

[*.mmd]
indent_size = 2

[*.{json,yml,yaml}]
indent_size = 2